generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------- ENUMS --------------------

enum UserRole {
  TRAINING_CENTRE
  DISTRICT_OFFICER
  QUALITY_OFFICER
  STATE_OFFICER
}

enum BatchStatus {
  DRAFT
  SUBMITTED
  DISTRICT_REVIEW
  QUALITY_REVIEW
  STATE_REVIEW
  RETURNED
  REJECTED
  APPROVED
  ISSUED
  CANCELLED
}

enum ApprovalStage {
  DISTRICT
  QUALITY
  STATE
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  RETURNED
}

enum CertificateStatus {
  VALID
  REVOKED
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

// -------------------- USERS --------------------

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainingCentreId String?
  trainingCentre   TrainingCentre? @relation(fields: [trainingCentreId], references: [id])

  createdBatches Batch[] @relation("BatchCreator")

  approvals Approval[]

  auditLogs AuditLog[]

  @@index([role])
}

// -------------------- TRAINING CENTRES --------------------

model TrainingCentre {
  id   String @id @default(uuid())
  name String
  code String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  batches Batch[]
}

// -------------------- BATCHES --------------------

model Batch {
  id          String      @id @default(uuid())
  batchNumber String      @unique
  courseName  String
  status      BatchStatus @default(DRAFT)

  candidateCount Int @default(0)

  requiresQualityReview Boolean @default(false)

  approvalRound Int @default(1)

  returnReason    String?
  rejectionReason String?

  submittedAt DateTime?
  approvedAt  DateTime?
  issuedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainingCentreId String
  trainingCentre   TrainingCentre @relation(fields: [trainingCentreId], references: [id])

  createdById String
  createdBy   User   @relation("BatchCreator", fields: [createdById], references: [id])

  candidates Candidate[]

  approvals Approval[]

  certificates Certificate[]

  auditLogs AuditLog[]

  @@index([status])
  @@index([trainingCentreId])
  @@index([createdAt])
}

// -------------------- CANDIDATES --------------------

model Candidate {
  id            String  @id @default(uuid())
  fullName      String
  phone         String
  email         String?
  candidateCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  certificate Certificate?

  notifications Notification[]

  @@unique([batchId, phone])
  @@index([batchId])
}

// -------------------- APPROVALS --------------------

model Approval {
  id       String           @id @default(uuid())
  stage    ApprovalStage
  decision ApprovalDecision
  comments String?

  round     Int
  createdAt DateTime @default(now())

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([batchId, round, stage, userId])
  @@index([batchId, round, stage])
  @@index([userId])
}

// -------------------- CERTIFICATES --------------------

model Certificate {
  id                String            @id @default(uuid())
  certificateNumber String            @unique
  status            CertificateStatus @default(VALID)

  issuedAt     DateTime  @default(now())
  revokedAt    DateTime?
  revokeReason String?

  pdfPath String?

  candidateId String    @unique
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id])

  notifications Notification[]

  @@index([batchId])
  @@index([status])
}

// -------------------- NOTIFICATIONS --------------------

model Notification {
  id     String             @id @default(uuid())
  status NotificationStatus @default(PENDING)

  recipientPhone String

  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  sentAt        DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  certificateId String
  certificate   Certificate @relation(fields: [certificateId], references: [id])

  @@index([status])
  @@index([certificateId])
}

// -------------------- AUDIT LOGS --------------------

model AuditLog {
  id       String @id @default(uuid())
  action   String
  entity   String
  entityId String
  details  Json?

  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  batchId String?
  batch   Batch?  @relation(fields: [batchId], references: [id])

  @@index([entity, entityId])
  @@index([batchId])
  @@index([userId])
  @@index([createdAt])
}
